{
  "description": "familiar-ai hooks: every event is handed to the familiar-ai binary, which checks the action against the record. Besides edits and shell commands, the hooks see the Agent spawn, a subagent's start and stop, the model switch, a spawn that did not return normally (PostToolUseFailure, so a case-finder that failed is recorded failed), and AskUserQuestion, which is where the person's cards and the push question appear in Claude Code's own picker. PostToolUse and Stop have 1800 s: room for the test run, the judge, and the investigator, which the binary starts from the PostToolUse that records the second failed try (Stop is the fallback) and waits for. Every other hook that opens the record has 200 s, since any of them may ask the judge. PreModelSwitch has 30 s; it opens nothing.",
  "modules": ["./register.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh SessionStart",
            "timeout": 200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh UserPromptSubmit",
            "timeout": 200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Agent|Task|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh PreToolUse",
            "timeout": 200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Agent|Task|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh PostToolUse",
            "timeout": 1800
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh await-run",
            "async": true,
            "asyncRewake": true,
            "timeout": 1920
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh PostToolUseFailure",
            "timeout": 200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh Stop",
            "timeout": 1800
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh SubagentStop",
            "timeout": 200
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh SubagentStart",
            "timeout": 200
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh PreModelSwitch",
            "timeout": 30
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh PostModelSwitch",
            "timeout": 200
          }
        ]
      }
    ]
  }
}
